<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_card_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_frosted_glass"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_card_album_art"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/app_name"
            android:scaleType="centerCrop"
            android:src="@drawable/img_magic_album_art" />

        <LinearLayout
            android:id="@+id/widget_card_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_card_service_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_widget_service_chip"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="MAGIC OS 10 • AUDIO"
                android:textColor="#00D2FF"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_card_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Sin reproducción activa"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_card_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Toca para abrir MagicMusic"
                android:textColor="#B8C7E0"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/widget_card_btn_source"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="Abrir servicio musical"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_magic_open"
            android:tint="#00D2FF" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/widget_card_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="10dp"
        android:max="1000"
        android:progress="350"
        android:progressBackgroundTint="#33FFFFFF"
        android:progressTint="#00D2FF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/widget_card_btn_custom_left"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Acción izquierda"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_magic_replay15"
            android:tint="#9CB3D6" />

        <ImageButton
            android:id="@+id/widget_card_btn_prev"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Anterior"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_magic_prev"
            android:tint="#FFFFFFFF" />

        <ImageButton
            android:id="@+id/widget_card_btn_play_pause"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_widget_play_pill"
            android:contentDescription="Reproducir o pausar"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_magic_play"
            android:tint="#FFFFFFFF" />

        <ImageButton
            android:id="@+id/widget_card_btn_next"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Siguiente"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_magic_next"
            android:tint="#FFFFFFFF" />

        <ImageButton
            android:id="@+id/widget_card_btn_custom_right"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Acción derecha"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_magic_forward15"
            android:tint="#9CB3D6" />
    </LinearLayout>
</LinearLayout>
