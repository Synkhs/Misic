<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_square_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/bg_widget_m3_tonal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_square_album_art"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:contentDescription="@string/cd_album_art"
                android:scaleType="centerCrop"
                android:src="@drawable/img_magic_album_art" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/widget_square_btn_source"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/menu_open_source"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_magic_open"
                    android:tint="#CDA9FF" />

                <TextView
                    android:id="@+id/widget_square_service_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="AUDIO"
                    android:textColor="#CDA9FF"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_square_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_square_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_empty_title"
                android:textColor="#F2EAFB"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_square_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_empty_subtitle"
                android:textColor="#CAC0D6"
                android:textSize="11sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/widget_square_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="6dp"
            android:max="1000"
            android:progress="350"
            android:progressBackgroundTint="#44FFFFFF"
            android:progressTint="#FFCDA9FF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/widget_square_btn_prev"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/action_previous"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_magic_prev"
                android:tint="#F2EAFB" />

            <ImageButton
                android:id="@+id/widget_square_btn_play_pause"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_widget_play_pill"
                android:contentDescription="@string/action_play_pause"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_magic_play"
                android:tint="#2A1A4A" />

            <ImageButton
                android:id="@+id/widget_square_btn_next"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/action_next"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_magic_next"
                android:tint="#F2EAFB" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
