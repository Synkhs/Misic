<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_card_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/bg_widget_m3_tonal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_card_album_art"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/cd_album_art"
                android:scaleType="centerCrop"
                android:src="@drawable/img_magic_album_art" />

            <LinearLayout
                android:id="@+id/widget_card_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_card_service_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_widget_service_chip"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:text="MAGICMUSIC • AUDIO"
                    android:textColor="#F2EAFB"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_card_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget_empty_title"
                    android:textColor="#F2EAFB"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_card_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget_empty_subtitle"
                    android:textColor="#CAC0D6"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/widget_card_btn_source"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/menu_open_source"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_magic_open"
                android:tint="#CDA9FF" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/widget_card_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="10dp"
            android:max="1000"
            android:progress="350"
            android:progressBackgroundTint="#44FFFFFF"
            android:progressTint="#FFCDA9FF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/widget_card_btn_custom_left"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="@string/action_previous"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_magic_replay15"
                android:tint="#CAC0D6" />

            <ImageButton
                android:id="@+id/widget_card_btn_prev"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="@string/action_previous"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_magic_prev"
                android:tint="#F2EAFB" />

            <ImageButton
                android:id="@+id/widget_card_btn_play_pause"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_widget_play_pill"
                android:contentDescription="@string/action_play_pause"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_magic_play"
                android:tint="#2A1A4A" />

            <ImageButton
                android:id="@+id/widget_card_btn_next"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="@string/action_next"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_magic_next"
                android:tint="#F2EAFB" />

            <ImageButton
                android:id="@+id/widget_card_btn_custom_right"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="@string/action_next"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_magic_forward15"
                android:tint="#CAC0D6" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
