<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_mini_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/bg_widget_m3_tonal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <ImageView
            android:id="@+id/widget_mini_album_art"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/cd_album_art"
            android:scaleType="centerCrop"
            android:src="@drawable/img_magic_album_art" />

        <LinearLayout
            android:id="@+id/widget_mini_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_mini_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_empty_title"
                android:textColor="#F2EAFB"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_mini_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_empty_subtitle"
                android:textColor="#CAC0D6"
                android:textSize="10sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/widget_mini_btn_play_pause"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_widget_play_pill"
            android:contentDescription="@string/action_play_pause"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_magic_play"
            android:tint="#2A1A4A" />
    </LinearLayout>
</FrameLayout>
